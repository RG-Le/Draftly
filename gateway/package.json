{
  "name": "draftly-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Draftly Gateway — REST API, OAuth, Gmail I/O, WebSocket",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --config jest.config.ts",
    "test:integration": "jest --config jest.integration.config.ts",
    "lint": "eslint src/",
    "migrate": "knex --knexfile src/infrastructure/database/knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile src/infrastructure/database/knexfile.ts migrate:rollback",
    "migrate:make": "knex --knexfile src/infrastructure/database/knexfile.ts migrate:make",
    "generate:keys": "node scripts/generate-keys.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.20.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.0.1",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "rate-limiter-flexible": "^5.0.0",
    "redlock": "^5.0.0-beta.2",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.10.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
